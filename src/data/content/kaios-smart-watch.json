      ]
    },
    {
      "kind": "content",
      "nodes": [
        {
          "type": "heading",
          "text": "FEATURES"
        },
        {
          "type": "heading",
          "text": "Voice Assistant"
        },
        {
          "type": "heading",
          "text": "Use voice commands and voice typing"
        },
        {
          "type": "heading",
          "text": "Communication"
        },
        {
          "type": "heading",
          "text": "Make and receive phone calls"
        },
        {
          "type": "heading",
          "text": "Training"
        },
        {
          "type": "heading",
          "text": "Track workouts and activities"
        },
        {
          "type": "heading",
          "text": "Health"
        },
        {
          "type": "heading",
          "text": "Monitor heart rate and gather fitness data"
        },
        {
          "type": "heading",
          "text": "Location Monitor"
        },
        {
          "type": "heading",
          "text": "Track child's location for safety"
        },
        {
          "type": "heading",
          "text": "Reminder"
        },
        {
          "type": "para",
          "text": "Set a reminder to stay on track with tasks"
        }
      ],
      "images": [
        "/images/9e817ffb15f2249d.png",
        "/images/addc15965d39a09b.png",
        "/images/6211287347c6484e.png",
