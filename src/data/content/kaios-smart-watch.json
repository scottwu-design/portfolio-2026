          "text": "DESIGN THINKING"
        },
        {
          "type": "list",
          "items": [
            "A Simple, Essential",
            "Yet Efficient Smart Watch Design"
          ]
        }
      ],
      "images": []
    },
    {
      "kind": "content",
      "nodes": [
        {
          "type": "heading",
          "text": "WHO ARE THE USERS?"
        }
      ],
      "images": [
        "/images/04f770ca55bc6c0b.png"
      ]
    },
    {
      "kind": "content",
      "nodes": [
        {
          "type": "heading",
          "text": "DESIGN OBJECTIVE"
        },
        {
          "type": "heading",
          "text": "Simple Navigation"
        },
        {
          "type": "para",
          "text": "A design is easy to use and learn so that users can easily operate the device."
        },
        {
          "type": "heading",
          "text": "Personalize for Users"
        },
        {
          "type": "para",
          "text": "A design is flexible enough to allow users to customize the launcher to fulfill their needs."
        },
        {
          "type": "heading",
          "text": "Speedy Action"
        },
        {
          "type": "para",
          "text": "A design that does not require many steps to get things done."
        },
        {
          "type": "heading",
          "text": "Clear Visual"
        },
        {
          "type": "para",
          "text": "A user interface design that users can browse and read clearly on a tiny watch display."
        }
      ],
      "images": [
        "/images/ca55bdcc53b0e2ee.png",
        "/images/11fcdcdfa09e1bf1.png",
